# Copy this file to .env.local and fill in a real key.

# Vercel AI Gateway key (recommended). Lets you use plain "provider/model"
# strings (e.g. "anthropic/claude-sonnet-5", "openai/text-embedding-3-small")
# for both chat and embeddings without installing provider-specific SDKs.
# Get one at https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Alternative: skip the gateway and call Anthropic directly for chat.
# (Embeddings still require an OpenAI key or AI_GATEWAY_API_KEY above.)
# ANTHROPIC_API_KEY=

# Alternative: skip the gateway and call OpenAI directly for embeddings.
# OPENAI_API_KEY=
